APP_ENV=development
APP_NAME=DigiCloset API
API_PREFIX=/api
DATABASE_URL=sqlite:///./digicloset.db
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
UPLOAD_DIR=uploads
UPLOAD_URL_PREFIX=/uploads
IMAGE_STORAGE_BACKEND=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=digicloset
MAX_UPLOAD_SIZE_BYTES=10485760
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_ALGORITHM=HS256
ENABLE_API_DOCS=true
# Production example:
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/digicloset
# Or, if your provider gives a plain SQLAlchemy URL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/digicloset
# CORS_ORIGINS=https://your-frontend-domain.vercel.app
# IMAGE_STORAGE_BACKEND=cloudinary
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_FOLDER=digicloset
# SECRET_KEY=use-a-long-random-secret
# ENABLE_API_DOCS=false
